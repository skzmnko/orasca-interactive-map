# Netlify Headers Configuration for Endorath Interactive Map
# ==========================================================

/*
  X-Frame-Options: DENY
  X-XSS-Protection: 1; mode=block
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# HTML - средний кэш (на случай обновлений контента)
/index.html
  Cache-Control: public, max-age=3600, must-revalidate

# Главная страница
/
  Cache-Control: public, max-age=3600, must-revalidate

# Тайлы карты - КЭШ НАВСЕГДА (они никогда не меняются)
/images/tiles/*
  Cache-Control: public, max-age=31536000, immutable

# Иконки маркеров - КЭШ НАВСЕГДА
/images/icons/*
  Cache-Control: public, max-age=31536000, immutable

# CSS файлы - КЭШ НАВСЕГДА
/css/*
  Cache-Control: public, max-age=31536000, immutable

# JavaScript файлы - КЭШ НАВСЕГДА  
/js/*
  Cache-Control: public, max-age=31536000, immutable

# JS модули локаций
/js/locations/*
  Cache-Control: public, max-age=31536000, immutable

# Географические данные
/js/locations/geography/*
  Cache-Control: public, max-age=31536000, immutable

# Регионы
/js/locations/regions/*
  Cache-Control: public, max-age=31536000, immutable

# Общие модули
/js/locations/shared/*
  Cache-Control: public, max-age=31536000, immutable

# Изображения локаций (могут обновляться) - долгий кэш
/images/locations/*
  Cache-Control: public, max-age=86400

# Фоновые изображения - долгий кэш
/images/graveplain-background.*
  Cache-Control: public, max-age=86400

# Другие изображения
/images/*.png
  Cache-Control: public, max-age=86400
/images/*.jpg
  Cache-Control: public, max-age=86400  
/images/*.webp
  Cache-Control: public, max-age=86400

# Безопасность - защита от кликджекинга
/*
  X-Frame-Options: DENY